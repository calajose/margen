{
  "name": "margen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor Markdown minimalista de escritura sin distracciones",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "poc": "vite --open /src/poc/index.html",
    "poc:corpus": "vitest run tests/roundtrip",
    "poc:bench": "vitest run tests/bench",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "empaquetar:arch": "node scripts/empaquetar-arch.mjs",
    "lint": "eslint src tests",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@milkdown/core": "^7.22.3",
    "@milkdown/plugin-history": "^7.22.3",
    "@milkdown/plugin-listener": "^7.22.3",
    "@milkdown/preset-commonmark": "^7.22.3",
    "@milkdown/preset-gfm": "^7.22.3",
    "@milkdown/prose": "^7.22.3",
    "@milkdown/utils": "^7.22.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
