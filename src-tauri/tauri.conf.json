{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margen",
  "version": "0.1.0",
  "identifier": "es.margen.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Margen",
        "width": 900,
        "height": 720,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Productivity",
    "shortDescription": "Editor Markdown minimalista",
    "longDescription": "Editor Markdown de escritura sin distracciones, local y sin red."
  }
}
